cd /etc/nginx/sites-available

nano domain.com

server {
    server_name rassociates.co.nz www.rassociates.co.nz;
    proxy_read_timeout 1800;
    proxy_connect_timeout 1800;
    proxy_send_timeout 1800;
    send_timeout 1800;

    location = /favicon.ico { access_log off; log_not_found off; }
    location /static/ {
        alias /home/pushpan/rassociates.co.nz/core/static/;
    }
    location /media/ {
        alias /home/pushpan/rassociates.co.nz/core/media/;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/ra_nz_wagtail.sock;
    }

}


sudo ln -s /etc/nginx/sites-available/rassociates.co.nz /etc/nginx/sites-enabled

sudo nginx -t

sudo systemctl restart nginx

sudo ufw delete allow 8000

sudo ufw allow 'Nginx Full'
